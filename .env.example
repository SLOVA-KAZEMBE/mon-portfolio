# Base de données PostgreSQL via Supabase
# Format : postgresql://postgres:[mot-de-passe]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URI=postgresql://postgres:votre_mot_de_passe@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# Initialisation
ADMIN_USERNAME=slova
ADMIN_PASSWORD=votre_mot_de_passe_admin
# Optionnel : mettez true uniquement si vous voulez vider puis recréer toutes les tables
RESET_DB=false
